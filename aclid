#!/bin/bash
# aclid — stay awake with the lid closed on AC, sleep normally on battery.
#
#   AC power:      pmset disablesleep 1   (lid close keeps the system running)
#   battery power: pmset disablesleep 0   (system sleeps as normal)
#   lid closed on AC: pmset displaysleepnow (display off immediately, system stays up)
#
# Two event streams, no polling:
#   - `pmset -g pslog`  power-source change events -> re-apply disablesleep
#   - `log stream` (ContinuityCaptureAgent "Clamshell closed status changed"
#     lines) lid-close events -> pmset displaysleepnow

set -euo pipefail

apply_state() {
  local line src
  line="$(pmset -g ps | head -1)"
  case "$line" in
    *"'AC Power'"*)
      src="AC"
      pmset disablesleep 1
      ;;
    *"'Battery Power'"*)
      src="battery"
      pmset disablesleep 0
      ;;
    *)
      echo "aclid: unrecognized power source line: $line" >&2
      return 1
      ;;
  esac
  echo "aclid: on $src -> SleepDisabled=$(pmset -g | awk '/SleepDisabled/{print $2}')"
}

# 0->1 == lid closed; 1->0 == lid opened
lid_watcher() {
  while true; do
    log stream --style compact \
      --predicate 'process == "ContinuityCaptureAgent" AND eventMessage CONTAINS[c] "Clamshell"' 2>/dev/null \
      | while IFS= read -r line; do
          case "$line" in
            *"Clamshell closed status changed from 0 to 1"*)
              # only matters when the system is being kept awake (AC mode)
              if [ "$(pmset -g | awk '/SleepDisabled/{print $2}')" = "1" ]; then
                echo "aclid: lid closed, system awake -> displaysleepnow"
                pmset displaysleepnow
              fi
              ;;
          esac
        done
    sleep 2   # restart the stream if it ever exits
  done
}

case "${1:-}" in
  run)
    apply_state   # set the correct state immediately (covers boot)
    lid_watcher &
    lidwatch=$!
    trap 'kill "$lidwatch" 2>/dev/null' TERM INT
    while true; do
      pmset -g pslog | while IFS= read -r _; do apply_state; done
      sleep 2      # if pslog ever exits, restart it
    done
    ;;
  status)
    pmset -g ps | head -1
    pmset -g | grep -i SleepDisabled
    ;;
  *)
    cat <<'USAGE'
aclid — stay awake with lid closed on AC, sleep normally on battery

  aclid run      daemon mode (run by launchd as root)
  aclid status   show power source and SleepDisabled state

Installed as a LaunchDaemon; managed with launchctl. Install/uninstall:
see README.md in this file's source directory.
USAGE
    exit 2 ;;
esac